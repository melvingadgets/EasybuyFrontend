VITE_API_MODE=local
VITE_API_LOCAL_URL=http://localhost:552
VITE_API_ONLINE_URL=https://easybuy-api-production.up.railway.app
VITE_NEXT_APP_URL=https://aurapaytracker.vercel.app
VITE_TIKTOK_PIXEL_ID=your_tiktok_pixel_id
# Melvin OS origins allowed to embed this app (comma-separated)
VITE_MELVIN_OS_ORIGINS=http://localhost:5173

# Unified auth service (usernames/passwords and tokens). Sign-in calls this, not the EasyBuy API.
# Defaults to the production service when unset; point it at a staging auth for testing.
# VITE_AUTH_BASE_URL=https://unified-auth-production.up.railway.app

# Optional override (takes highest priority):
# VITE_API_BASE_URL=http://localhost:552
